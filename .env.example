# Auto Finance API - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env (desenvolvimento) e .env.test (testes)
# ⚠️ IMPORTANTE: Você precisa de DOIS arquivos .env separados:
#   - .env          → Banco de desenvolvimento/produção (auto-finance)
#   - .env.test     → Banco de testes (auto-finance-bd-test)

# ============================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ============================================
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASS=admin123
DB_NAME=auto-finance

# ============================================
# CONFIGURAÇÃO DA APLICAÇÃO
# ============================================
PORT=3000

# ============================================
# OBSERVAÇÕES:
# ============================================
# - DB_PORT=5433 corresponde ao mapeamento do docker-compose.yml (host:5433 -> container:5432)
# - No deploy Docker, o container da API usa DB_HOST=db e DB_PORT=5432 (rede interna Docker)
# - O banco de testes (auto-finance-bd-test) é criado automaticamente via docker/init.sql
# - Nunca commite arquivos .env reais com credenciais no controle de versão